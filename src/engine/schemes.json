  "schemes": [
    {
      "id": "pmkisan",
      "nameKey": "scheme.pmkisan.name",
      "icon": "💰",
      "benefitKey": "scheme.pmkisan.benefit",
      "yearlyAmount": 6000,
      "conditions": [
        { "id": "ownsLand", "field": "ownsLand", "op": "isTrue", "failAs": "not_eligible",
          "passKey": "reason.pmkisan.ownsLand.pass", "failKey": "reason.pmkisan.ownsLand.fail" },
        { "id": "cutoff", "field": "landAfter2019", "op": "notIn", "value": ["yes", "dontKnow"], "failAs": "check_office",
          "passKey": "reason.pmkisan.cutoff.pass", "failKey": "reason.pmkisan.cutoff.fail" },
        { "id": "incomeTaxYes", "field": "incomeTax", "op": "notEquals", "value": "yes", "failAs": "not_eligible",
          "passKey": "reason.pmkisan.incomeTax.pass", "failKey": "reason.pmkisan.incomeTax.fail" },
        { "id": "incomeTaxUnsure", "field": "incomeTax", "op": "notEquals", "value": "dontKnow", "failAs": "check_office",
          "passKey": "reason.pmkisan.incomeTax.pass", "failKey": "reason.pmkisan.incomeTax.unsure" },
        { "id": "pensionYes", "field": "pensionOrGovtJob", "op": "notEquals", "value": "yes", "failAs": "not_eligible",
          "passKey": "reason.pmkisan.pension.pass", "failKey": "reason.pmkisan.pension.fail" },
        { "id": "pensionUnsure", "field": "pensionOrGovtJob", "op": "notEquals", "value": "dontKnow", "failAs": "check_office",
          "passKey": "reason.pmkisan.pension.pass", "failKey": "reason.pmkisan.pension.unsure" },
        { "id": "professionalYes", "field": "professionalOrPost", "op": "notEquals", "value": "yes", "failAs": "not_eligible",
          "passKey": "reason.pmkisan.professional.pass", "failKey": "reason.pmkisan.professional.fail" },
        { "id": "professionalUnsure", "field": "professionalOrPost", "op": "notEquals", "value": "dontKnow", "failAs": "check_office",
          "passKey": "reason.pmkisan.professional.pass", "failKey": "reason.pmkisan.professional.unsure" }
      ],
      "tips": [
        { "when": { "field": "bankEkyc", "op": "notEquals", "value": "yes" }, "key": "tip.pmkisan.ekyc" }
      ],
      "documents": ["doc.landRecord", "doc.aadhaarCard", "doc.bankPassbookLinked"],
      "deadlines": [],
      "notes": ["note.pmkisan.farmerId", "note.pmkisan.nameMatch"],
      "sourceUrl": "https://pmkisan.gov.in",
      "lastVerified": "2026-10-22"
    },
    {
      "id": "pmfby",
      "nameKey": "scheme.pmfby.name",
      "icon": "🛡️",

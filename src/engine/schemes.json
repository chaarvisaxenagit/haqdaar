        { "id": "cropNotified", "field": "cropNotified", "op": "isTrue", "failAs": "check_office",
          "passKey": "reason.pmfby.cropNotified.pass", "failKey": "reason.pmfby.cropNotified.fail" }
      ],
      "tips": [
        { "when": { "field": "hasKcc", "op": "equals", "value": "yes" }, "key": "tip.pmfby.askBank" }
